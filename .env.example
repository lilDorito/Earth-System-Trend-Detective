# mock = synthetic data for every variable, no network, no token (default)
# live = each variable uses the source set in configs/variables.yaml
#        (air_temperature, precipitation: NASA POWER, no token needed)
DATA_MODE=mock

# Earthdata Login token (profile -> Generate Token), needed only in live mode
# EARTHDATA_TOKEN=

# CACHE_DIR=data/cache
# REQUEST_TIMEOUT_S=60

# pages allowed to call the API: exact origin, comma-separated, no trailing slash
# not needed locally (npm run dev proxies /api)
# CORS_ORIGINS=https://earth-trend-detective.vercel.app
